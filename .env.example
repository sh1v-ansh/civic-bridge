# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# LibreTranslate — run locally with Docker:
# docker run -ti --rm -p 5000:5000 libretranslate/libretranslate
LIBRE_TRANSLATE_URL=http://localhost:5000

# Express session secret (change in production!)
SESSION_SECRET=civicbridge-dev-secret-change-me

# Open States API key (optional, improves rate limits) — https://openstates.org/api/
OPEN_STATES_API_KEY=

# Server port (optional, defaults to 3001)
PORT=3001
